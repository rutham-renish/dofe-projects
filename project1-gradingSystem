students = []
marks = []
boundaries = []
grades = []
sortedStudents = []
sortedMarks = []
sortedGrades = []
error = True
student = " "
mark = 0
totalMarks = 0
default = ""
bigIndex = 0
percentage = 0
grade = 0
while student != "":
    student = input("Enter the name of a student: ")
    if student != "":
        mark = int(input(f"Enter the marks of {student}: "))
        students.append(student)
        marks.append(mark)

# EDIT: Exception Handling
while error:
    try: # Try runs the part of the code that could have a potential error and does not break the entire code (outside the exception handling block)
        totalMarks = int(input("How much marks was the test totally out of: ")) # Potential error where the user can give a data type other than integer
        error = False
    except ValueError: # Except checks if the error is the same specified (ValueError in this case) and gives a result
        print("Please enter a number, any other characters are not allowed")

default = input("Do you want to use the default grade boundaries (y/n): ").lower()
if default == "n":
    for i in range (9,0,-1):
        percent = int(input(f"Enter the percentage required to get a grade {i} (only numbers): "))
        boundaries.append(percent)
else:
    boundaries = [90,80,70,60,50,40,30,20,10]

for i in range(len(students)):
    percentage = marks[i] / totalMarks * 100
    grade = 0
    for j in range(len(boundaries)):
        if percentage >= boundaries[j] and grade == 0:
            grade = 9-j
    grades.append(grade)

for i in range(len(students)):
    bigIndex = 0
    for j in range(len(students)):
        if marks[j] > marks[bigIndex]:
            bigIndex = j
    sortedStudents.append(students[bigIndex])
    sortedMarks.append(marks[bigIndex])
    sortedGrades.append(grades[bigIndex])
    students.remove(students[bigIndex])
    marks.remove(marks[bigIndex])
    grades.remove(grades[bigIndex])

for i in range(len(sortedStudents)):
    print(i+1,"-",sortedStudents[i],"with a grade",sortedGrades[i],"and",str(sortedMarks[i])+"/"+str(totalMarks))
